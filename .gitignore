# Environment files hold secrets: never commit them. Only the examples,
# which contain placeholders, are tracked.
.env
.env.*
!.env.example
deploy/.env.production
!deploy/.env.production.example

# Python virtual environments
.venv/
venv/
env/
backend/pyannote-env/

# Python cache and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node dependencies
node_modules/
docs/
test-audio/
# Local dev-server launch settings (machine-specific paths)
.claude/launch.json
secrets.txt
ai-prompts.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
build/
dist/
*.egg-info/

# ZIP archives
*.zip

# Local notes and sample audio
ToDoInFuture.txt
sample_chunk_00.wav
sample_chunk_01.wav
sample_chunk_02.wav
sample_two_speakers.wav
Old.wav

# Encrypted call recordings (RECORDING_DIR) are never committed.
backend/data/recordings/
