# ==============================================================================
# Call Analysis LLM Server - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Gateway & Network Settings
# ------------------------------------------------------------------------------
# External port exposed to the service-centre product
PROXY_PORT=8091

# Host to bind the proxy server
PROXY_HOST=0.0.0.0

# Upstream engine URL (internal container or localhost port for vLLM / llama.cpp)
UPSTREAM_ENGINE_URL=http://localhost:8000

# Secret API Key required for client requests (Authorization: Bearer <API_KEY>)
# Change this to a secure random token in production!
API_KEY=sk-callanalysis-automotive-dev-secret-token-2026

# ------------------------------------------------------------------------------
# 2. Concurrency & Overload Protection
# ------------------------------------------------------------------------------
# Maximum simultaneous in-flight inference requests allowed.
# If incoming requests exceed this threshold, the proxy immediately returns
# HTTP 429 Too Many Requests (or 503) with a 'Retry-After' header to prevent hangs.
MAX_CONCURRENT_REQUESTS=10

# Seconds the client should wait before retrying when a 429/503 is returned
RETRY_AFTER_SECONDS=2

# Maximum timeout in seconds for an individual inference request before aborting
REQUEST_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 3. Model & LoRA Adapter Configuration
# ------------------------------------------------------------------------------
# Base Model Hugging Face ID or local path on disk:
# - Production baseline: openai/gpt-oss-20b
# - Multilingual Indic alternative: Qwen/Qwen2.5-14B-Instruct or Qwen/Qwen2.5-7B-Instruct
# - Local merged model path: /models/merged-automotive-20b
MODEL_PATH=openai/gpt-oss-20b

# Fine-tuned LoRA Adapter (Hugging Face PEFT format):
# Set ENABLE_LORA=true to activate dynamic LoRA serving in vLLM.
ENABLE_LORA=false
LORA_ADAPTER_NAME=automotive-call-lora
LORA_ADAPTER_PATH=/models/lora-adapter

# ------------------------------------------------------------------------------
# 4. GPU & Engine Optimization Settings (vLLM)
# ------------------------------------------------------------------------------
# Fraction of total GPU VRAM dedicated to model weights and KV cache (0.85 - 0.95)
GPU_MEMORY_UTILIZATION=0.90

# Maximum model context window in tokens (transcript ~2k-6k tokens + 1k prompt/completion)
MAX_MODEL_LEN=8192

# Enable Automatic Prefix Caching to reuse KV cache for recurring system prompts
ENABLE_PREFIX_CACHING=true

# Tensor Parallelism size (number of GPUs to shard the model across, e.g. 1, 2, 4)
TENSOR_PARALLEL_SIZE=1

# Quantization method (leave empty for none, or: awq, gptq, fp8, bitsandbytes)
QUANTIZATION=

# ------------------------------------------------------------------------------
# 5. CPU Engine Fallback (llama.cpp)
# ------------------------------------------------------------------------------
# Path to GGUF model file when running the CPU development engine
CPU_GGUF_MODEL_PATH=/models/gpt-oss-20b-Q4_K_M.gguf
CPU_THREADS=8
