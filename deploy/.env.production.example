# Production settings for deploy/docker-compose.prod.yml.
#
#   cp deploy/.env.production.example deploy/.env.production
#   # replace every "replace-with-..." value, then:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production up -d --build
#
# deploy/.env.production is git-ignored; keep real secrets only there (or
# in your secret manager). This example holds placeholders only.
#
# The compose file sets these itself, so they are NOT read from here:
#   APP_ENV=production, DATABASE_URL (built from the POSTGRES_* values below),
#   REDIS_URL=redis://redis:6379/0, LIVE_STATE_STORE_PROVIDER=redis,
#   CALL_MAPPING_STORE_PROVIDER=redis
# With APP_ENV=production the API refuses to start on unsafe settings and
# lists what to fix.

# --- Compose stack (used by docker-compose.prod.yml itself) ---
POSTGRES_USER=calls
# Required. Generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=multilingual_call_intelligence
# Host port the web app (nginx) is published on; put your TLS proxy in front.
WEB_PORT=8080
# true builds the backend image with the pyannote/torch stack (large).
INSTALL_DIARIZATION=false

# --- Authentication ---
# Required: random, at least 32 characters, e.g. openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Creates the first admin while no user exists. Sign in, create the real
# accounts under Administration, then clear both values and redeploy.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# At least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- Web app ---
# The public origin(s) of the web app, comma-separated. Never "*".
CORS_ALLOWED_ORIGINS=https://calls.example.com
LOG_LEVEL=INFO
LOG_FORMAT=json
# When set, GET /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=replace-with-a-random-metrics-token
# Migrations run when the backend container starts; false to run them yourself.
RUN_MIGRATIONS=true

# --- AI providers ---
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b
ASR_PROVIDER=sarvam
LANGUAGE_PROVIDER=sarvam
SARVAM_API_KEY=replace-with-your-sarvam-api-key
# "rule_based" (no LLM calls) or "llm".
SUMMARY_PROVIDER=rule_based
ESCALATION_PROVIDER=rule_based
EMERGING_COMPLAINT_PROVIDER=rule_based
EMERGING_COMPLAINT_AUTO_DISCOVERY=true
EMERGING_COMPLAINT_DISCOVERY_MAX_CALLS=200
# Background discovery starts at most this often (seconds).
EMERGING_COMPLAINT_DISCOVERY_MIN_INTERVAL_SECONDS=300
ROLE_PROVIDER=order_based
# Local diarization needs INSTALL_DIARIZATION=true and a Hugging Face token.
# DIARIZATION_PROVIDER=pyannote
# HUGGINGFACE_TOKEN=replace-with-your-hugging-face-token
DIARIZATION_CPU_THREADS=4

# --- Live state (Redis) ---
LIVE_STATE_KEY_PREFIX=live_state
# Live analysis of a call without new speech expires after this (seconds).
LIVE_ANALYSIS_TTL_SECONDS=14400
# Lifetime of the single-use ticket a browser uses to open a live WebSocket.
LIVE_CALL_WS_TOKEN_TTL_SECONDS=60
LIVE_CALL_PUSH_INTERVAL_SECONDS=0.5

# --- Telephony (Plivo) ---
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=replace-with-your-plivo-auth-id
PLIVO_AUTH_TOKEN=replace-with-your-plivo-auth-token
PLIVO_VALIDATE_SIGNATURES=true
# Must match the public host exactly (webhook signatures cover the URL).
PLIVO_PUBLIC_BASE_URL=https://calls.example.com
PLIVO_STREAM_BASE_URL=wss://calls.example.com
PLIVO_STREAM_FLUSH_SECONDS=8.0
# Live audio is sent for transcription when the speaker pauses (at least
# MIN_SPEECH seconds of speech, then PAUSE seconds quieter than SILENCE_RMS);
# PLIVO_STREAM_FLUSH_SECONDS is the upper limit. PAUSE=0 = fixed-length chunks.
PLIVO_STREAM_PAUSE_SECONDS=0.6
PLIVO_STREAM_MIN_SPEECH_SECONDS=1.5
PLIVO_STREAM_SILENCE_RMS=350
TELEPHONY_STREAM_AUTH_REQUIRED=true
TELEPHONY_STREAM_TOKEN_TTL_SECONDS=3600

# --- Post-call repair ---
POST_CALL_REPAIR_INTERVAL_SECONDS=300
POST_CALL_REPAIR_MIN_AGE_SECONDS=120
POST_CALL_REPAIR_MAX_ATTEMPTS=5

# --- CRM boundary ---
CRM_PROVIDER=none
# CRM_JSON_PATH=/app/data/customers.json
PHONE_DEFAULT_COUNTRY_CODE=91

# --- Customer summary after the call (opt-in) ---
CUSTOMER_SUMMARY_ENABLED=false
CUSTOMER_SUMMARY_DELIVERY_PROVIDER=disabled
CUSTOMER_SUMMARY_DEFAULT_CHANNEL=sms
CUSTOMER_SUMMARY_CONSENT_REQUIRED=true
# SMS_GATE_USERNAME=replace-with-your-sms-gate-username
# SMS_GATE_PASSWORD=replace-with-your-sms-gate-password
