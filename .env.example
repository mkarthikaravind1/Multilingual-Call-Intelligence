# Local development settings.
#
#   cp .env.example .env        # then fill in your own keys
#
# The backend reads .env from the repository root. This file is committed,
# so it holds placeholders only; never put real secrets here. For a
# production deployment use deploy/.env.production.example instead.
#
# Every setting has a default in backend/app/core/config.py; a variable
# left out (or commented out) uses that default. Don't leave a numeric or
# true/false setting empty: "KEY=" is an error, not "use the default".

APP_ENV=development

# --- AI providers ---
# LLM used for complaint detection, sentiment and next-question suggestions.
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b

# Speech-to-text and language identification (Sarvam).
ASR_PROVIDER=sarvam
LANGUAGE_PROVIDER=sarvam
SARVAM_API_KEY=replace-with-your-sarvam-api-key
# codemix keeps English words in English letters inside Tamil etc.
# (transcribe spells them in Tamil script). Empty to send no mode.
SARVAM_STT_MODE=codemix
# Live audio: once 2 chunks in a row of a speaker are heard in the same
# Indian language, Sarvam is told that language (ta-IN etc.) instead of
# guessing it from each few-second chunk. 0 turns it off.
ASR_LANGUAGE_LOCK_AFTER=2
ASR_LANGUAGE_UNLOCK_AFTER=2
# After the call, transcribe the recorded call again in windows of up to 25 s,
# in each speaker's language, and keep that transcript (more accurate than
# the live one, heard a few seconds at a time). About doubles the ASR cost.
# Recordings wait in memory on the instance that streamed the call.
POST_CALL_RETRANSCRIPTION_ENABLED=true
POST_CALL_RETRANSCRIPTION_WINDOW_SECONDS=25
CALL_RECORDING_MAX_CALLS=20
CALL_RECORDING_MAX_SECONDS=3600

# Speaker diarization: "pyannote" (local, needs backend/requirements-diarization.txt
# and a Hugging Face token) or "scripted" (tests/demos). Unset = no diarization.
# DIARIZATION_PROVIDER=pyannote
# HUGGINGFACE_TOKEN=replace-with-your-hugging-face-token
# PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# CPU threads for pyannote (0 = torch default of every core, which can be 20x+ slower).
DIARIZATION_CPU_THREADS=4
# Speaker roles (ICR / customer). "session" learns them per call: from the
# call's tracks when Plivo dials the ICR (PLIVO_ICR_DIAL_TARGETS), otherwise
# by recognising voices across chunks and what each speaker says.
ROLE_PROVIDER=session
# Also ask the LLM (LLM_PROVIDER) when the phrases leave roles unclear.
ROLE_LLM_ENABLED=false
# Comma-separated phrases from the ICR's call-opening script.
ROLE_ICR_PHRASES=
# Mixed audio: voice similarity (cosine) for "same speaker", speakers per call.
SPEAKER_MATCH_THRESHOLD=0.45
SPEAKER_MAX_PER_CALL=2

# Post-call summary, escalation and emerging-complaint providers:
# "rule_based" (no LLM calls) or "llm".
# Service estimate: "llm" reads the whole call for the services it needs
# (any supported language, understands "the battery is fine"); falls back
# to the price-list keywords when the LLM fails. "rule_based" = keywords only.
ESTIMATION_PROVIDER=llm
# Prices come from the price list supervisors upload on the Price List page.
# Each API instance re-reads it at most this often (seconds).
PRICE_LIST_CACHE_SECONDS=30
# GPT-OSS reasoning effort (low = far fewer tokens against Groq's limits),
# and how many times a rate-limited Groq call is retried.
GROQ_REASONING_EFFORT=low
GROQ_MAX_RETRIES=4
# A live call's AI analysis runs at most once every N seconds (0 = no limit).
# Each run makes 4-5 LLM requests over the whole transcript; urgent
# escalations (manager, refund, legal) do not wait for it.
LIVE_ANALYSIS_MIN_INTERVAL_SECONDS=30
# combined: complaints, sentiment and escalation in one LLM request during a
# call (fewer tokens); separate: one request each. After the call: separate.
LIVE_ANALYSIS_MODE=combined
# Check each suggested question against what the customer already said
# (one extra short LLM request per suggestion).
QUESTION_ANSWERED_CHECK=true
# The model for that check (empty: GROQ_MODEL).
QUESTION_CHECK_MODEL=openai/gpt-oss-120b
SUMMARY_PROVIDER=rule_based
ESCALATION_PROVIDER=rule_based
EMERGING_COMPLAINT_PROVIDER=rule_based
EMERGING_COMPLAINT_AUTO_DISCOVERY=true
# Calls read by one discovery run, and the minimum gap between background runs.
EMERGING_COMPLAINT_DISCOVERY_MAX_CALLS=200
EMERGING_COMPLAINT_DISCOVERY_MIN_INTERVAL_SECONDS=300
# Accepted themes become complaint categories; each API instance re-reads
# them at most this often (seconds).
COMPLAINT_CATEGORY_CACHE_SECONDS=30

# --- Authentication ---
# Sign-in is refused for LOGIN_FAILURE_WINDOW_SECONDS after this many failed
# attempts for one email, or from one address.
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_ADDRESS=20
LOGIN_FAILURE_WINDOW_SECONDS=900
# A session can be refreshed for this long after signing in.
AUTH_SESSION_MAX_HOURS=12
# Any value works locally; production needs a random 32+ character secret.
AUTH_SECRET_KEY=change-me-in-development
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Creates this admin at startup while no user exists (then remove both).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- PostgreSQL ---
# Matches the defaults of the local docker-compose.yml (local development
# only; override them with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/multilingual_call_intelligence

# --- Redis (optional locally) ---
# With one backend process everything can stay in memory. Use redis to
# try the multi-instance setup: docker compose up -d redis
# REDIS_URL=redis://localhost:6379/0
# LIVE_STATE_STORE_PROVIDER=redis
# CALL_MAPPING_STORE_PROVIDER=redis
# COVERAGE_STORE_PROVIDER=redis
LIVE_STATE_STORE_PROVIDER=in_memory
CALL_MAPPING_STORE_PROVIDER=in_memory

# --- Web app ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Telephony (Plivo, optional) ---
# TELEPHONY_PROVIDER=plivo
# PLIVO_AUTH_ID=replace-with-your-plivo-auth-id
# PLIVO_AUTH_TOKEN=replace-with-your-plivo-auth-token
# Public URLs Plivo can reach (e.g. an https tunnel to this machine).
# PLIVO_PUBLIC_BASE_URL=https://your-tunnel.example.com
# PLIVO_STREAM_BASE_URL=wss://your-tunnel.example.com
PLIVO_VALIDATE_SIGNATURES=true
PLIVO_STREAM_FLUSH_SECONDS=6.0
# Audio format asked of Plivo: l16_16k (16 kHz linear PCM, best for Tamil
# transcription), l16_8k or mulaw_8k (phone quality, the old default).
PLIVO_STREAM_AUDIO=l16_16k
# Live audio is sent for transcription when the speaker pauses (at least
# MIN_SPEECH seconds of speech, then PAUSE seconds quieter than SILENCE_RMS);
# PLIVO_STREAM_FLUSH_SECONDS is the upper limit. PAUSE=0 = fixed-length chunks.
# Keep the limit above MIN_SPEECH + PAUSE (3.0 s here), or no pause is ever
# detected; speech cut by the limit is joined into the same live utterance.
# Chunks under ~2.5 s of speech are where words and the language are misheard.
PLIVO_STREAM_PAUSE_SECONDS=0.5
PLIVO_STREAM_MIN_SPEECH_SECONDS=2.5
PLIVO_STREAM_SILENCE_RMS=350
# Who an incoming call is connected to: comma-separated numbers (E.164) and/or
# SIP endpoints (sip:icr@example.com), rung together. When set, the customer
# (caller) and the ICR are streamed as separate tracks, so roles are exact.
PLIVO_ICR_DIAL_TARGETS=
PLIVO_ICR_CALLER_ID=
PLIVO_ICR_DIAL_TIMEOUT_SECONDS=30

# --- CRM boundary ---
# "none", or "json_file" with a customer file such as backend/data/crm_sample.json.
# The file is read again when it changes. An invalid customer is skipped and
# logged; a phone number two customers share matches neither automatically.
CRM_PROVIDER=none
CRM_JSON_PATH=
PHONE_DEFAULT_COUNTRY_CODE=91

# --- Customer summary after the call (opt-in) ---
CUSTOMER_SUMMARY_ENABLED=false
# "disabled" (nothing is sent; recorded as not sent), "noop" (recorded as
# sent without sending, for demos) or "sms_gate".
CUSTOMER_SUMMARY_DELIVERY_PROVIDER=disabled
CUSTOMER_SUMMARY_DEFAULT_CHANNEL=sms
CUSTOMER_SUMMARY_CONSENT_REQUIRED=true
# The longest SMS sent, in parts (153 Latin or 67 Tamil characters each); a
# longer summary is replaced by a short standard message. 0 = no limit.
CUSTOMER_SUMMARY_SMS_MAX_PARTS=3
# A text that failed is tried again every RETRY_INTERVAL seconds (0 = never)
# until it was attempted MAX_ATTEMPTS times.
CUSTOMER_SUMMARY_RETRY_INTERVAL_SECONDS=300
CUSTOMER_SUMMARY_MAX_ATTEMPTS=5
# SMS Gateway for Android credentials (CUSTOMER_SUMMARY_DELIVERY_PROVIDER=sms_gate).
# SMS_GATE_USERNAME=replace-with-your-sms-gate-username
# SMS_GATE_PASSWORD=replace-with-your-sms-gate-password

# --- Learning loop ---
# Corrections are proposed as an improvement once at least MIN_CORRECTIONS
# match, from at least MIN_CALLS calls, and they make up at least
# MIN_CORRECTION_RATE of the calls on which the AI gave that output.
LEARNING_PATTERN_MIN_CORRECTIONS=3
LEARNING_PATTERN_MIN_CALLS=2
LEARNING_PATTERN_MIN_CORRECTION_RATE=0.3

# On-screen alerts on live calls (the supervisor's Live Calls page and the
# executive's own call). Nothing is sent anywhere.
# A complaint not asked about this long after it was detected.
ALERT_UNCOVERED_AFTER_SECONDS=60
# Categories that always alert, comma-separated (any category with "safety"
# in its name does too).
ALERT_HIGH_SEVERITY_CATEGORIES=Hygiene
# A complaint detected with less confidence than this (0 to 1).
ALERT_LOW_CONFIDENCE_BELOW=0.6
# Poor audio: this many of the last 6 stretches of speech could not be
# transcribed, or the last lines' average transcription confidence (when
# the recogniser gives one) is below the second value.
ALERT_POOR_AUDIO_UNRECOGNISED_CHUNKS=3
ALERT_POOR_AUDIO_CONFIDENCE_BELOW=0.6

# Call recordings kept on disk, encrypted (AES-256-GCM), for a set number of
# days. Off unless turned on: recording calls needs the customer's consent.
# Calls started in the web app carry no audio and are never recorded.
RECORDING_ENABLED=false
# With several API instances this must be a folder they share.
RECORDING_DIR=data/recordings
# 32 random bytes in base64. Make one (from backend/) with:
#   python -c "from app.services.recording_archive import generate_key; print(generate_key())"
# Keep a copy somewhere safe: without it no stored recording can be read.
RECORDING_ENCRYPTION_KEY=
RECORDING_RETENTION_DAYS=90
# How often expired recordings are removed, in seconds (0: never).
RECORDING_RETENTION_SWEEP_SECONDS=3600
