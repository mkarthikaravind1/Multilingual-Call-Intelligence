# Copy this file to .env and fill in real values for your machine.
# This file is committed to version control — it must NEVER contain
# real secrets, only placeholders showing what variables exist.

APP_ENV=development

# Identifies which concrete provider adapter to use (set later)
ASR_PROVIDER=
LLM_PROVIDER=
SARVAM_API_KEY=
LANGUAGE_PROVIDER=

# Connection strings (set later)
DATABASE_URL=
REDIS_URL=