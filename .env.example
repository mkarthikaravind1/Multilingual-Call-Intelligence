# Copy this file to .env and fill in real values for your machine.
# This file is committed to version control — it must NEVER contain
# real secrets, only placeholders showing what variables exist.

APP_ENV=development

# Identifies which concrete provider adapter to use (set later)
ASR_PROVIDER=
LLM_PROVIDER=
SARVAM_API_KEY=
LANGUAGE_PROVIDER=
DIARIZATION_PROVIDER=
PYANNOTE_MODEL=
HUGGINGFACE_TOKEN=
AUTH_SECRET_KEY=change-me-in-development
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Connection strings
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/multilingual_call_intelligence
REDIS_URL=