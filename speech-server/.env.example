# Speech-to-Text Server Configuration

# Model settings
# Options: "openai/whisper-large-v3-turbo", "Systran/faster-whisper-large-v3-turbo", "tiny", "base", etc.
MODEL_NAME_OR_PATH=openai/whisper-large-v3-turbo

# Engine backend: "faster-whisper" | "indic-conformer" | "fake"
MODEL_BACKEND=faster-whisper

# Device: "cuda" | "cpu" | "auto"
DEVICE=auto

# Compute type: "float16", "int8", "float32", "int8_float16", "auto"
COMPUTE_TYPE=auto

# Authentication: If set, every request requires "Authorization: Bearer <token>"
# Leave empty or unset for open access
SPEECH_SERVER_TOKEN=

# Server networking
HOST=0.0.0.0
PORT=8090

# Concurrency: Maximum simultaneous transcription jobs
MAX_CONCURRENT_TRANSCRIPTIONS=10

